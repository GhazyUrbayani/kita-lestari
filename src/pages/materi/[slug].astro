---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { asParagraphs, imageSourceUrl, isHttpUrl, materi, pdfPreviewUrl, type Materi } from "../../lib/content";
import { deck, slideMateri, slideUrl } from "../../lib/lokakarya";

export function getStaticPaths() {
  return materi.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: Materi };
const slide = slideMateri(item.slug);
---

<BaseLayout
  title={item.judul ?? "Materi"}
  description={item.ringkasan || `Materi ${item.judul}: Edukasi pemilahan sampah dan penerapan biopori pedesaan Desa Sukalaksana oleh PKM-PM ITB Pelita Muda.`}
  live={{ page: "material", sources: ["materi"], slug: item.slug }}
>
  <section class="page-intro" data-live="material-header">
    <h1>{item.judul}</h1>
    {item.ringkasan && <p>{item.ringkasan}</p>}
  </section>

  {/* Slide disimpan di dalam situs, bukan diambil dari Spreadsheet, jadi
      letaknya di luar kotak yang ditimpa oleh isi versi live. */}
  {slide.length > 0 && (
    <section class="content-section" aria-label={`Slide lokakarya untuk ${item.judul ?? "materi ini"}`}>
      <ol class="slide-gallery">
        {slide.map((butir) => (
          <li>
            <figure class="slide-item">
              <img
                src={slideUrl(butir.nomor)}
                alt={butir.alt}
                width="1600"
                height="900"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="slide-nomor">{butir.nomor}</span>{butir.judul}
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
      <p class="action-row">
        <a class="action-link" href={deck.href}>Lihat slide lengkap</a>
        <a class="action-link action-link-kedua" href={deck.pdf} download>Unduh {deck.pdfLabel}</a>
      </p>
    </section>
  )}

  <article class="content-card material-page" data-live="material-detail">
    {isHttpUrl(item.gambar_url) && <img src={imageSourceUrl(item.gambar_url)} alt={item.judul ?? "Gambar materi"} loading="lazy" />}
    {asParagraphs(item.isi).map((paragraph) => <p>{paragraph}</p>)}
    {isHttpUrl(item.pdf_url) && <details class="document-embed">
      <summary class="action-link">Tampilkan PDF materi di halaman ini</summary>
      <div class="document-embed-panel">
        <iframe src={pdfPreviewUrl(item.pdf_url)} title={`PDF ${item.judul ?? "materi"}`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin">
          PDF tidak dapat dimuat di halaman ini.
        </iframe>
      </div>
    </details>}
  </article>
</BaseLayout>
