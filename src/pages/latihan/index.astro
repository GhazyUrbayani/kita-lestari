---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { idPaket, latihan, opsiSoal, soalPaket } from "../../lib/content";
---

<BaseLayout title="Latihan soal" live={{ page: "practice", sources: ["latihan", "soal"] }}>
  <section class="page-intro">
    <h1>Latihan soal</h1>
    <p>Pilih paket yang ingin dikerjakan. Nilai dan pembahasan muncul begitu tombol Selesai ditekan.</p>
  </section>
  <div data-live="practice">{latihan.length ? (
    <ul class="card-list">
      {latihan.map((item) => {
        const butir = soalPaket(item.judul_paket);
        const id = idPaket(item.judul_paket);
        return (
          <li>
            <article class="content-card">
              <h2>{item.judul_paket}</h2>
              {item.keterangan && <p>{item.keterangan}</p>}
              {butir.length ? (
                <details class="quiz-embed">
                  <summary class="action-link">Tampilkan soal {item.judul_paket} di halaman ini</summary>
                  <div class="quiz-panel">
                    <form class="quiz" data-paket={item.judul_paket}>
                      <p class="quiz-langkah" role="status"></p>
                      <ol class="quiz-list">
                        {butir.map((soal, urutan) => (
                          <li class="quiz-item" data-kunci={soal.kunci?.trim().toUpperCase()}>
                            <fieldset>
                              <legend>{soal.nomor ?? urutan + 1}. {soal.pertanyaan}</legend>
                              {opsiSoal(soal).map((opsi) => (
                                <label class="quiz-option">
                                  <input type="radio" name={`${id}-${urutan + 1}`} value={opsi.huruf} />
                                  <span>{opsi.huruf}. {opsi.teks}</span>
                                </label>
                              ))}
                            </fieldset>
                            <p class="quiz-note" hidden></p>
                            {soal.pembahasan && <p class="quiz-pembahasan" hidden>{soal.pembahasan}</p>}
                          </li>
                        ))}
                      </ol>
                      <p class="quiz-sisa" role="status"></p>
                      <div class="quiz-actions" hidden>
                        <button type="button" class="action-link quiz-prev">Sebelumnya</button>
                        <button type="button" class="action-link quiz-next">Berikutnya</button>
                        <button type="submit" class="action-link quiz-selesai">Selesai dan lihat hasil</button>
                        <button type="button" class="action-link quiz-reset" hidden>Kerjakan ulang</button>
                      </div>
                      <section class="quiz-result" aria-live="polite" hidden></section>
                    </form>
                  </div>
                </details>
              ) : (
                <p>Paket ini belum tersedia. Pengelola perlu mengisi soalnya di tab <code>soal</code>.</p>
              )}
            </article>
          </li>
        );
      })}
    </ul>
  ) : (
    <p>Belum ada paket soal yang diterbitkan.</p>
  )}</div>
  <script src="/scripts/quiz.js" defer></script>
</BaseLayout>
