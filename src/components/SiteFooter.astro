---
import { logos } from "../lib/lokakarya";

const { includeAdminLink = false } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <section aria-labelledby="footer-mitra">
      <h2 id="footer-mitra">Pendukung program</h2>
      <div class="logo-strip">
        {logos.map((logo) => (
          <img src={logo.berkas} alt={logo.nama} height="34" loading="lazy" decoding="async" />
        ))}
      </div>
    </section>
    <nav aria-label="Tautan tambahan">
      <ul class="footer-links">
        <li><a href="/tentang">Tentang tim</a></li>
        <li><a href="/panduan">Panduan pengelola</a></li>
        {includeAdminLink && <li><a href="/admin">Panel pengelola</a></li>}
      </ul>
    </nav>
  </div>
</footer>
